# ========================================================
# Bengaluru Startup Jobs Map - Root Environment Variables
# ========================================================
# Copy this file to .env (or backend/.env and frontend/.env.local)

# --- Backend Configuration (FastAPI) ---
ENVIRONMENT=development
PROJECT_NAME="Bengaluru Startup Jobs Map API"
VERSION=0.1.0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration (Placeholder safe defaults - no live DB required for initial phase)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=blr_startup_jobs

# Optional explicit Database URL (leave blank to auto-compose from POSTGRES_* variables)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/blr_startup_jobs

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_APP_NAME="Bengaluru Startup Jobs Map"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"
