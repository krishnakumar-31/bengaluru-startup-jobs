# Environment configuration
ENVIRONMENT=development
PROJECT_NAME="Bengaluru Startup Jobs Map API"
VERSION=0.1.0

# CORS Configuration (comma-separated or JSON list in settings)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration (Placeholder safe defaults - no live DB required for initial phase)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bengaluru_jobs

# Optional explicit Database URL (leave blank to auto-compose from POSTGRES_* variables)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bengaluru_jobs

# Super Admin Account Configuration
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=618816
ADMIN_JWT_SECRET=replace-with-a-random-secure-secret-key-in-production
ADMIN_JWT_EXPIRE_MINUTES=480
